<Project>

  <!--
    Shared build settings for every project in the Rooms solution.
    Project-specific concerns (TargetFramework, UseWPF, package refs) stay in
    each .csproj. Cross-cutting compiler behaviour lives here so it stays in one place.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>Rooms</Authors>
    <Product>Rooms</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
