<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test project. Targets net8.0-windows so it can reference the Windows-targeted
    Rooms.Os project. Lower layers are exercised through their interfaces with fakes.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rooms.Core\Rooms.Core.csproj" />
    <ProjectReference Include="..\..\src\Rooms.Application\Rooms.Application.csproj" />
    <ProjectReference Include="..\..\src\Rooms.Persistence\Rooms.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Rooms.Os\Rooms.Os.csproj" />
  </ItemGroup>

</Project>
