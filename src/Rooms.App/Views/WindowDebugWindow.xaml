<Window x:Class="Rooms.App.Views.WindowDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rooms — Debug: window ownership"
        Width="760" Height="540" Background="#111827"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="14,5" Background="#2563EB"
                    Foreground="White" BorderThickness="0" Command="{Binding RefreshCommand}" />
            <TextBlock Text="{Binding Header}" Foreground="#F9FAFB" FontSize="13"
                       FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#9CA3AF" FontSize="11" Margin="2,8,0,0"
                   Text="Tip: switch rooms with your hotkeys, then click Refresh to see what each room shows. 'loose' windows appear only in Home." />

        <ListView ItemsSource="{Binding Rows}" Background="#0B1220" Foreground="#E5E7EB"
                  BorderBrush="#374151" BorderThickness="1" FontFamily="Consolas" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Process" Width="140" DisplayMemberBinding="{Binding Process}" />
                    <GridViewColumn Header="Title" Width="330" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Visible" Width="70" DisplayMemberBinding="{Binding Visible}" />
                    <GridViewColumn Header="Owner / room" Width="190" DisplayMemberBinding="{Binding Owner}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
