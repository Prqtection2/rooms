<Window x:Class="Rooms.App.Views.RoomEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#111827" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Title}" Foreground="#F9FAFB" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

        <TextBlock Text="Name" Foreground="#9CA3AF" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />

        <Border Background="#1F2937" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox Content="Home room (keep all my windows visible)" IsChecked="{Binding IsHome}" />
                <TextBlock Text="A catch-all home base you can always return to. It shows every open window, so the 'owned apps' below don't apply to it."
                           Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="Accent colour (hex, e.g. #3B82F6)" Foreground="#9CA3AF" />
        <TextBox Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />

        <TextBlock Text="Owned apps (process names, e.g. notepad, msedge, code)" Foreground="#9CA3AF" />
        <DockPanel Margin="0,2,0,4">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddMatcherCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding NewMatcherProcess, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding MatcherProcessNames}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Content="Remove" Background="#374151"
                                Command="{Binding DataContext.RemoveMatcherCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding}" Foreground="#F9FAFB" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,12,0,2">
            <Button DockPanel.Dock="Right" Content="Capture all open apps" Background="#374151"
                    Command="{Binding CaptureOpenAppsCommand}" />
            <TextBlock Text="Capture from open windows" Foreground="#9CA3AF" VerticalAlignment="Center" />
        </DockPanel>
        <Border Background="#0B1220" CornerRadius="6" Padding="4" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RunningWindows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,1">
                                <Button DockPanel.Dock="Right" Content="Add" Background="#374151"
                                        Command="{Binding DataContext.AddRunningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding Display}" Foreground="#D1D5DB" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Text="Auto-launch on entry" Foreground="#9CA3AF" Margin="0,14,0,0" />
        <DockPanel Margin="0,2,0,4">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddAutoLaunchCommand}" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Browse" Background="#374151" Command="{Binding BrowseExeCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding NewAutoLaunchPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding AutoLaunchPaths}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Content="Remove" Background="#374151"
                                Command="{Binding DataContext.RemoveAutoLaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding}" Foreground="#F9FAFB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Isolated browser (its own window/profile per room)" Foreground="#9CA3AF" Margin="0,14,0,0" />
        <DockPanel Margin="0,2,0,4">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddIsolatedBrowserCommand}" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding AvailableBrowsers}" SelectedItem="{Binding NewIsolatedBrowser}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding IsolatedBrowsers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Content="Remove" Background="#374151"
                                Command="{Binding DataContext.RemoveIsolatedBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding}" Foreground="#F9FAFB" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}" />
            <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="Cancel" Background="#374151" Margin="0,0,8,0" />
            <Button Content="Delete room" Background="#7F1D1D" HorizontalAlignment="Left"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DeleteCommand}" />
        </DockPanel>
    </StackPanel>
</Window>
