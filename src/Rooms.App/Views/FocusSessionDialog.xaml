<Window x:Class="Rooms.App.Views.FocusSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start focus session" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#111827" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="Start a focus session" FontSize="18" FontWeight="SemiBold" Foreground="#F9FAFB" Margin="0,0,0,14" />

        <TextBlock Text="Room to focus in" Foreground="#9CA3AF" />
        <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Name" Margin="0,2,0,12" />

        <TextBlock Text="Duration (minutes)" Foreground="#9CA3AF" />
        <DockPanel Margin="0,2,0,12">
            <TextBox DockPanel.Dock="Right" Width="56" Text="{Binding Minutes}" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Button Content="15" Background="#374151" Margin="0,0,6,0" Command="{Binding PresetCommand}" CommandParameter="15" />
                <Button Content="25" Background="#374151" Margin="0,0,6,0" Command="{Binding PresetCommand}" CommandParameter="25" />
                <Button Content="50" Background="#374151" Command="{Binding PresetCommand}" CommandParameter="50" />
            </StackPanel>
        </DockPanel>

        <CheckBox Content="Lock me in (switching away asks to give up)" IsChecked="{Binding LockMe}" />

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Start" Command="{Binding StartCommand}" />
            <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="Cancel" Background="#374151" Margin="0,0,8,0" />
            <TextBlock />
        </DockPanel>
    </StackPanel>
</Window>
