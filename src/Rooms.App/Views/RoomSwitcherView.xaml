<UserControl x:Class="Rooms.App.Views.RoomSwitcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Flat, dark-card button -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#374151" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#1F2937" CornerRadius="10" Padding="10">
        <StackPanel>
            <TextBlock Text="Rooms" Foreground="#F9FAFB" FontSize="16" FontWeight="SemiBold" Margin="4,2,0,8" />

            <!-- Focus session bar (§12.5) -->
            <Border Background="#3F2D1A" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                    Visibility="{Binding FocusBar.IsActive, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Give up" Style="{StaticResource FlatButton}"
                            Foreground="#FCA5A5" Command="{Binding FocusBar.GiveUpCommand}" />
                    <StackPanel>
                        <TextBlock Text="Focus session" Foreground="#FBBF24" FontSize="11" />
                        <TextBlock Text="{Binding FocusBar.Remaining}" Foreground="#F9FAFB" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Room list (§12.1) -->
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#2563EB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <DockPanel>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Accent}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>

                            <Button Grid.Column="1" Content="&#x270E;" Style="{StaticResource FlatButton}"
                                    Foreground="#9CA3AF" Padding="8,6"
                                    ToolTip="Edit room"
                                    Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="#374151" Margin="0,8" />

            <!-- Footer -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Settings" Style="{StaticResource FlatButton}"
                        Foreground="#9CA3AF" Command="{Binding OpenSettingsCommand}" />
                <Button Content="&#x2B; New room" Style="{StaticResource FlatButton}"
                        Foreground="#60A5FA" Command="{Binding NewRoomCommand}" />
            </DockPanel>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="Show all" Style="{StaticResource FlatButton}"
                        Foreground="#9CA3AF" ToolTip="Re-show every window and leave all rooms"
                        Command="{Binding ShowAllCommand}" />
                <Button Content="Reset room" Style="{StaticResource FlatButton}"
                        Foreground="#9CA3AF" ToolTip="Close session extras and relaunch this room's defaults"
                        Command="{Binding ResetActiveRoomCommand}" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
